{
  "name": "vue-easy-gantt",
  "version": "2.0.1",
  "description": "A modern Vue 3 gantt chart component for presenting weekly tasks.",
  "type": "module",
  "main": "dist/vue-easy-gantt.js",
  "module": "dist/vue-easy-gantt.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-easy-gantt.mjs",
      "require": "./dist/vue-easy-gantt.js"
    },
    "./style.css": "./dist/vue-easy-gantt.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "author": {
    "name": "ZEO",
    "email": "no-reply@ai.xsin.work",
    "url": "https://github.com/aispin"
  },
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "vue components",
    "gantt",
    "gantt chart",
    "vue gantt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aispin/vue-easy-gantt.git"
  },
  "bugs": {
    "url": "https://github.com/aispin/vue-easy-gantt/issues"
  },
  "homepage": "https://github.com/aispin/vue-easy-gantt#readme",
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.build.json && node scripts/inject-css-import.mjs",
    "build:demo": "vite build --base=/vue-easy-gantt/",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "pages": "bash ./scripts/deploy-pages.sh"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "three": "^0.186.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dayjs": "^1.11.23"
  }
}
